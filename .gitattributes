# Detectar automáticamente archivos de texto y normalizar saltos de línea a LF
* text=auto eol=lf

# Forzar CRLF en archivos específicos de Windows si los usan
*.bat text eol=crlf
*.cmd text eol=crlf

# Evitar que Git altere archivos binarios comunes en videojuegos
*.png binary
*.jpg binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.blend binary

# Archivos de texto propios de Godot
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
